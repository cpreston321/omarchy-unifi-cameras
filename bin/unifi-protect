#!/usr/bin/env bash
# Command-line surface for the UniFi Cameras plugin. The QML panel shells out to
# this script for everything; nothing in the panel speaks HTTP directly.

set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/protect.sh
source "$SELF_DIR/../lib/protect.sh"

usage() {
  cat <<'USAGE'
usage: unifi-protect <command> [args]

setup [host] [port]     Find or pin a console, store an API key (stdin), verify
scan                    Find UniFi Protect consoles on this network
logo                    Cache the console's own logo for the panel
key-set                 Replace the stored API key, read from stdin
forget                  Remove the stored key and config
check                   Verify connectivity and print console identity
status                  Setup state as JSON, for the panel (never fails)
cameras [--json]        List cameras
snapshot <id> [path]    Fetch a JPEG (defaults to the snapshot cache)
refresh                 Refresh cached snapshots for every connected camera
stream-url <id> [q]     Print the RTSPS URL for quality q (high|medium|low)
toggle <id> <k> <on|off> Set led, osd-name, osd-date, osd-logo, or detect-<type>
play <id> [q]           Open the live stream in mpv
relay <id> [q]          Remux the stream to loopback HTTP for the panel (foreground)
ptz-goto <id> <slot>    Move a PTZ camera to a preset slot
ptz-patrol <id> <slot>  Start a PTZ patrol
ptz-stop <id>           Stop a PTZ patrol
export <id>             Save a snapshot into ~/Pictures/UniFi/<date>/
probe <path>            Raw GET against the integration API, for verification
USAGE
}

# ------------------------------------------------------------------ discovery

# A console answers the integration API with 401 when no key is presented.
# That is a far better fingerprint than a TLS certificate or an open port:
# plenty of things serve HTTPS on 443, but only Protect serves this path.
readonly API_PROBE_PATH='/meta/info'
readonly SCAN_PARALLEL=48
readonly SCAN_MAX_HOSTS=512

scan_probe() {
  local ip=$1 out=$2 code
  code="$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --insecure --proto '=https' --noproxy '*' --no-location \
    --connect-timeout 1 --max-time 3 \
    "https://${ip}/proxy/protect/integration/v1${API_PROBE_PATH}" 2>/dev/null)" || return 0
  [[ $code == 401 || $code == 200 ]] && printf '%s\n' "$ip" >> "$out"
  return 0
}

# Hosts worth probing: everything this machine has spoken to recently, plus the
# /24 around its own address. A console is nearly always one or the other, and
# sweeping wider costs seconds for no realistic gain.
scan_candidates() {
  local self_ips prefix
  self_ips="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}')"

  {
    ip neigh show 2>/dev/null | awk '$1 ~ /^[0-9]+\./ {print $1}'
    local cidr
    for cidr in $self_ips; do
      prefix="${cidr%.*}"
      seq -f "${prefix}.%g" 1 254
    done
  } | sort -u -t. -k1,1n -k2,2n -k3,3n -k4,4n | head -n "$SCAN_MAX_HOSTS"
}

cmd_scan() {
  require_tools curl ip
  local tmp batch=0
  tmp="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" RETURN

  local ip
  while IFS= read -r ip; do
    [[ -n $ip ]] || continue
    scan_probe "$ip" "$tmp" &
    batch=$((batch + 1))
    if (( batch >= SCAN_PARALLEL )); then
      wait
      batch=0
    fi
  done < <(scan_candidates)
  wait

  sort -u "$tmp"
}

# ------------------------------------------------------------------ setup

# Offers what the scan found, and falls back to asking. Always returns a host
# on stdout, or empty if the user declined everything.
setup_choose_host() {
  local -a found=()
  printf 'Looking for a UniFi Protect console on this network…\n' >&2
  mapfile -t found < <(cmd_scan)

  if [[ ${#found[@]} -eq 1 ]]; then
    local answer
    printf 'Found a console at %s. Use it? [Y/n] ' "${found[0]}" >&2
    read -r answer || true
    if [[ -z $answer || $answer =~ ^[Yy] ]]; then
      printf '%s\n' "${found[0]}"
      return
    fi
  elif [[ ${#found[@]} -gt 1 ]]; then
    local index=1 choice
    printf 'Found %d consoles:\n' "${#found[@]}" >&2
    for host in "${found[@]}"; do
      printf '  %d) %s\n' "$index" "$host" >&2
      index=$((index + 1))
    done
    printf 'Choose one [1-%d], or press Enter to type an address: ' "${#found[@]}" >&2
    read -r choice || true
    if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#found[@]} )); then
      printf '%s\n' "${found[choice - 1]}"
      return
    fi
  else
    printf 'No console answered on this network.\n' >&2
  fi

  local typed
  printf 'Console IP or hostname: ' >&2
  read -r typed || true
  printf '%s\n' "$typed"
}

cmd_setup() {
  local host=${1-} port=${2:-443}
  # The panel's setup button opens a terminal on `setup` with no argument, so
  # the console is discovered rather than demanded. Typing an IP address off
  # the back of a rack-mounted NVR is a poor first impression.
  if [[ -z $host && -t 0 ]]; then
    host="$(setup_choose_host)"
  fi
  [[ -n $host ]] || die "usage: unifi-protect setup <host> [port]"
  [[ $host =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid host"
  [[ $port =~ ^[0-9]+$ ]] || die "port must be numeric"
  require_tools curl jq openssl secret-tool

  local pin
  pin="$(fetch_pin "$host" "$port")"
  printf 'Pinned certificate: %s\n' "$pin" >&2

  local key=""
  if [[ -t 0 ]]; then
    printf 'Paste the Protect API key (Control Plane > Integrations): ' >&2
    read -rs key || true
    printf '\n' >&2
  else
    read -r key || true
  fi
  key="${key//[$'\r\n\t ']/}"
  api_key_valid "$key" || die "that does not look like a Protect API key"

  config_write "$host" "$port" "$pin"
  printf '%s' "$key" | api_key_store "$host"
  unset key

  cmd_check
  cmd_logo >/dev/null 2>&1 || true
}

cmd_key_set() {
  local host key=""
  host="$(console_host)"
  if [[ -t 0 ]]; then
    printf 'Paste the Protect API key: ' >&2
    read -rs key || true
    printf '\n' >&2
  else
    read -r key || true
  fi
  key="${key//[$'\r\n\t ']/}"
  api_key_valid "$key" || die "that does not look like a Protect API key"
  printf '%s' "$key" | api_key_store "$host"
  unset key
  cmd_check
}

cmd_forget() {
  # Has to work on a broken config, not just a valid one — a config that fails
  # to load is exactly when someone reaches for `forget`. The host is read
  # leniently so a missing or malformed one still leaves the files removed.
  local host=""
  if config_present; then
    host="$(jq -r '.console.host // empty' "$(config_path)" 2>/dev/null || true)"
  fi
  [[ -n $host ]] && api_key_clear "$host"
  rm -f "$(config_path)"
  rm -rf "$(snapshot_dir)"
  printf 'Removed stored key, config, and cached snapshots.\n'
}

cmd_check() {
  local info
  info="$(api_request GET /meta/info)"
  printf '%s\n' "$info" | jq -r '"Connected to \(.applicationVersion // "Protect") on \(.name // "console")"'
}

# Setup state as JSON, for the panel. Always exits 0 and never touches the
# network: the panel needs to tell "no console" from "no key" from "bad key" to
# offer the right action, and parsing English out of stderr is not that.
cmd_status() {
  local state detail host="" configured=false has_key=false key=""

  if ! config_present; then
    state="no-console"
    detail="No console has been connected yet."
  elif ! jq -e . "$(config_path)" >/dev/null 2>&1; then
    state="bad-config"
    detail="The saved console settings are not readable."
  else
    host="$(jq -r '.console.host // empty' "$(config_path)" 2>/dev/null || true)"
    if [[ -z $host ]]; then
      state="bad-config"
      detail="The saved console settings have no address."
    else
      configured=true
      key="$(secret-tool lookup application omarchy-unifi kind api-key host "$host" 2>/dev/null || true)"
      if [[ -z $key ]]; then
        state="no-key"
        detail="Create an API key on the console under Control Plane > Integrations, then add it here."
      elif ! api_key_valid "$key"; then
        has_key=true
        state="bad-key"
        detail="The key in your keyring is not in the format Protect issues."
      else
        has_key=true
        state="ready"
        detail=""
      fi
    fi
  fi
  unset key

  jq -n --arg state "$state" --arg host "$host" --arg detail "$detail" \
    --argjson configured "$configured" --argjson hasKey "$has_key" \
    '{state: $state, host: $host, detail: $detail, configured: $configured, hasKey: $hasKey}'
}

# The console's own favicon, cached for the panel's title.
#
# Fetched from the user's hardware rather than shipped with the plugin: the
# mark is Ubiquiti's, and pulling it from the console the user already owns
# avoids redistributing it. Same host, so the certificate pin still applies.
cmd_logo() {
  config_load
  require_tools curl
  local out tmp
  out="$(cache_dir)/logo.svg"
  mkdir -p "$(cache_dir)"
  tmp="$(mktemp "${out}.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" RETURN

  local -a args
  mapfile -t args < <(curl_common)
  args+=(--request GET --max-filesize 262144 --output "$tmp")
  args+=("$(console_origin)/favicon.svg")

  curl "${args[@]}" || die "could not fetch the console logo"
  [[ -s $tmp ]] || die "the console returned an empty logo"
  head -c 200 "$tmp" | grep -qi "<svg" || die "the console did not return an SVG"
  mv "$tmp" "$out"
  printf '%s\n' "$out"
}

# ------------------------------------------------------------------ cameras

cameras_json() { api_request GET /cameras; }

cmd_cameras() {
  if [[ ${1-} == --json ]]; then
    cameras_json
    return
  fi
  cameras_json | jq -r '.[] | [.id, (.state // "UNKNOWN"), (.name // "camera")] | @tsv' \
    | column -t -s "$(printf '\t')"
}

camera_name() {
  cameras_json | jq -r --arg id "$1" '.[] | select(.id == $id) | .name // "camera"'
}

cmd_snapshot() {
  local id=${1-} out=${2-}
  [[ -n $id ]] || die "usage: unifi-protect snapshot <id> [path]"
  [[ -n $out ]] || out="$(snapshot_dir)/${id}.jpg"
  api_snapshot "$id" "$out"
}

# Refreshes the cache the panel reads. Failures for one camera never abort the
# sweep: a single offline doorbell must not blank the whole grid.
cmd_refresh() {
  local dir id list tmp
  dir="$(snapshot_dir)"
  mkdir -p "$dir"
  [[ -s "$(cache_dir)/logo.svg" ]] || cmd_logo >/dev/null 2>&1 || true
  # The Omalaunch provider runs under a five-second budget and must not touch
  # the network, so the camera list is cached here for it to read offline.
  list="$(cache_dir)/cameras.json"
  tmp="$(mktemp "$(cache_dir)/.cameras.XXXXXX")"
  if cameras_json | jq '[.[] | {id, name, state, type: (.modelKey // "camera"), featureFlags}]' > "$tmp" 2>/dev/null; then
    mv "$tmp" "$list"
  else
    rm -f "$tmp"
  fi
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    api_snapshot "$id" "$dir/${id}.jpg" >/dev/null 2>&1 || true
  done < <(cameras_json | jq -r '.[] | select((.state // "") == "CONNECTED") | .id')
  printf '%s\n' "$dir"
}

cmd_export() {
  local id=${1-}
  [[ -n $id ]] || die "usage: unifi-protect export <id>"
  local base name stamp out
  base="$( (xdg-user-dir PICTURES 2>/dev/null) || printf '%s/Pictures' "$HOME")"
  name="$(camera_name "$id" | tr -cd '[:alnum:]._- ' | tr ' ' '-')"
  stamp="$(date +%Y-%m-%d)"
  out="$base/UniFi/$stamp/${name:-camera}-$(date +%H%M%S).jpg"
  api_snapshot "$id" "$out"
}

# ---------------------------------------------------------------- settings

# Camera settings the integration API will actually accept. Verified writable
# on Protect 7.2.105 by sending each field back with its current value:
# isMicEnabled looks writable and is not, and anything outside this map is
# rejected outright with an AJV additional-properties error.
#
# A partial sub-object is accepted, so a single flag does not require sending
# the whole settings blob back and racing whatever else changed it.
toggle_apply() {
  local id=$1 setting=$2 enabled=$3
  case $setting in
    led)      api_request PATCH "/cameras/${id}" \
                "$(jq -nc --argjson v "$enabled" '{ledSettings: {isEnabled: $v}}')" ;;
    osd-name) api_request PATCH "/cameras/${id}" \
                "$(jq -nc --argjson v "$enabled" '{osdSettings: {isNameEnabled: $v}}')" ;;
    osd-date) api_request PATCH "/cameras/${id}" \
                "$(jq -nc --argjson v "$enabled" '{osdSettings: {isDateEnabled: $v}}')" ;;
    osd-logo) api_request PATCH "/cameras/${id}" \
                "$(jq -nc --argjson v "$enabled" '{osdSettings: {isLogoEnabled: $v}}')" ;;
    detect-*)
      # objectTypes is a whole array, so this one alone is read-modify-write.
      # The list is rebuilt from what the console reports right now rather than
      # from anything cached, so a change made in the Protect app is not undone.
      local kind=${setting#detect-} current
      current="$(api_request GET "/cameras/${id}" | jq -c '.smartDetectSettings.objectTypes // []')"
      api_request PATCH "/cameras/${id}" "$(jq -nc \
        --argjson list "$current" --arg kind "$kind" --argjson on "$enabled" \
        '{smartDetectSettings: {objectTypes:
          (if $on then ($list + [$kind] | unique) else ($list - [$kind]) end)}}')" ;;
    *) die "unknown setting '$setting'" ;;
  esac
}

cmd_toggle() {
  local id=${1-} setting=${2-} state=${3-}
  [[ -n $id && -n $setting && -n $state ]] \
    || die "usage: unifi-protect toggle <id> <setting> <on|off>"
  local enabled
  case $state in
    on|true|1)  enabled=true ;;
    off|false|0) enabled=false ;;
    *) die "state must be on or off" ;;
  esac
  toggle_apply "$id" "$setting" "$enabled" >/dev/null
}

# ------------------------------------------------------------------ streaming

# Verified against Protect 7.2.105: the integration API's camera object has no
# channels and no RTSP field, and PATCH /cameras/{id} rejects both with an AJV
# "must NOT have additional properties" error. RTSP can only be turned on in the
# Protect app, so the only useful thing to do here is say so.
rtsp_disabled_message() {
  printf 'RTSP is off for this camera. Open Protect > the camera > Settings > Advanced > RTSP, enable a stream, then try again.'
}

# Asks for every quality at once and prefers the requested one. Enabling RTSP
# is per-quality in the Protect app, so a console commonly has `high` live and
# medium/low null — asking only for the configured quality would report the
# camera as having no stream when it plainly has one.
stream_url_any() {
  api_request GET "/cameras/${1}/rtsps-stream?qualities=high,medium,low" \
    | jq -r --arg q "$2" '(.[$q] // null) as $wanted
      | if $wanted != null then $wanted
        else ([to_entries[] | select(.value != null) | .value] | first // empty) end'
}

# Enables the channel and retries once when the console reports no URL, since
# Protect ships with RTSP off and "no stream" is a setup state rather than a
# failure. Callers get a URL or an error, never a silent empty line.
cmd_stream_url() {
  local id=${1-} quality=${2:-high}
  [[ -n $id ]] || die "usage: unifi-protect stream-url <id> [quality]"
  local url
  url="$(stream_url_any "$id" "$quality")"
  [[ -n $url ]] || die "$(rtsp_disabled_message)"
  printf '%s\n' "$url"
}

# The URL carries a per-channel alias that grants stream access, so it goes to
# mpv through a stdin playlist rather than argv.
cmd_play() {
  local id=${1-} quality=${2:-high}
  [[ -n $id ]] || die "usage: unifi-protect play <id> [quality]"
  require_tools mpv
  local url title
  url="$(cmd_stream_url "$id" "$quality")"
  title="$(camera_name "$id")"
  # FFmpeg verifies the peer certificate by default, and a UniFi console serves
  # a self-signed one issued to an internal name, so RTSPS fails outright
  # without this. Transport trust for the stream is the LAN itself; the HTTP
  # API keeps its certificate pin, which is where credentials actually travel.
  printf '%s\n' "$url" | mpv --playlist=- \
    --no-config --load-scripts=no --terminal=no \
    --demuxer-lavf-o=tls_verify=0 --rtsp-transport=tcp \
    --profile=low-latency --cache=no --untimed \
    --title="${title:-UniFi camera}" \
    --force-media-title="${title:-UniFi camera}" &
  disown
}

# ------------------------------------------------------------------ events

# Local relay so the panel can show live video.
#
# FFmpeg verifies peer certificates by default and the console serves a
# self-signed one; mpv can be told to skip that, but Qt Multimedia exposes no
# such knob and fails with an unrelated-looking error. So ffmpeg does the TLS
# and remuxes the stream — no re-encoding, so no meaningful CPU cost — into
# plain MPEG-TS over HTTP on the loopback, which Qt opens without complaint.
#
# Runs in the foreground and prints the local URL once the socket is actually
# accepting. The caller owns the lifetime: killing this kills the relay.
cmd_relay() {
  local id=${1-} quality=${2:-medium}
  [[ -n $id ]] || die "usage: unifi-protect relay <id> [quality]"
  require_tools ffmpeg ss

  local url port
  url="$(cmd_stream_url "$id" "$quality")"

  port="$(pick_free_port)"
  [[ -n $port ]] || die "no free loopback port for the relay"

  # Bound to 127.0.0.1 so the stream never leaves this machine.
  ffmpeg -nostdin -loglevel error \
    -tls_verify 0 -rtsp_transport tcp -i "$url" \
    -c copy -f mpegts -listen 1 "http://127.0.0.1:${port}" &
  local ffmpeg_pid=$!

  # shellcheck disable=SC2064
  trap "kill $ffmpeg_pid 2>/dev/null || true" EXIT INT TERM

  # The trap covers an orderly stop, but not SIGKILL. Two things can die that
  # way: this script (Quickshell signals its direct child, and escalates to
  # KILL when TERM is ignored) and the shell hosting the panel (which would
  # leave this script orphaned but running). The watchdog outlives both, and
  # ffmpeg holds a port and a camera substream until something reaps it.
  local self=$$ parent=$PPID
  (
    while kill -0 "$ffmpeg_pid" 2>/dev/null \
      && kill -0 "$self" 2>/dev/null \
      && kill -0 "$parent" 2>/dev/null; do
      sleep 1
    done
    kill "$ffmpeg_pid" 2>/dev/null || true
  ) &
  disown

  # The listening socket only appears after ffmpeg has opened the RTSP input,
  # which takes a moment. Announcing the URL before then would hand the panel
  # an address that refuses the connection.
  local waited=0
  while (( waited < 100 )); do
    if ss -ltnH "sport = :${port}" 2>/dev/null | grep -q .; then
      printf 'http://127.0.0.1:%s\n' "$port"
      wait "$ffmpeg_pid"
      return
    fi
    if ! kill -0 "$ffmpeg_pid" 2>/dev/null; then
      die "the relay could not open the stream"
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  die "the relay did not start listening in time"
}

pick_free_port() {
  local port attempt
  for attempt in $(seq 1 40); do
    port=$(( 20000 + RANDOM % 20000 ))
    ss -ltnH "sport = :${port}" 2>/dev/null | grep -q . || { printf '%s\n' "$port"; return; }
  done
}

# ------------------------------------------------------------------ PTZ

cmd_ptz_goto() {
  local id=${1-} slot=${2-}
  [[ -n $id && $slot =~ ^-?[0-9]+$ ]] || die "usage: unifi-protect ptz-goto <id> <slot>"
  api_request POST "/cameras/${id}/ptz/goto/${slot}" >/dev/null
}

cmd_ptz_patrol() {
  local id=${1-} slot=${2-}
  [[ -n $id && $slot =~ ^[0-9]+$ ]] || die "usage: unifi-protect ptz-patrol <id> <slot>"
  api_request POST "/cameras/${id}/ptz/patrol/start/${slot}" >/dev/null
}

cmd_ptz_stop() {
  local id=${1-}
  [[ -n $id ]] || die "usage: unifi-protect ptz-stop <id>"
  api_request POST "/cameras/${id}/ptz/patrol/stop" >/dev/null
}

# ------------------------------------------------------------------ probe

# Escape hatch for confirming what a specific firmware actually exposes, so a
# shape mismatch can be diagnosed without editing the plugin.
cmd_probe() {
  local path=${1-}
  [[ $path == /* ]] || die "usage: unifi-protect probe /cameras"
  api_request GET "$path"
}

# ------------------------------------------------------------------ dispatch

main() {
  local cmd=${1-}
  [[ $# -gt 0 ]] && shift || true
  case $cmd in
    setup)       cmd_setup "$@" ;;
    scan)        cmd_scan "$@" ;;
    logo)        cmd_logo "$@" ;;
    key-set)     cmd_key_set "$@" ;;
    forget)      cmd_forget "$@" ;;
    check)       cmd_check "$@" ;;
    status)      cmd_status "$@" ;;
    cameras)     cmd_cameras "$@" ;;
    snapshot)    cmd_snapshot "$@" ;;
    refresh)     cmd_refresh "$@" ;;
    export)      cmd_export "$@" ;;
    stream-url)  cmd_stream_url "$@" ;;
    play)        cmd_play "$@" ;;
    toggle)      cmd_toggle "$@" ;;
    ptz-goto)    cmd_ptz_goto "$@" ;;
    ptz-patrol)  cmd_ptz_patrol "$@" ;;
    ptz-stop)    cmd_ptz_stop "$@" ;;
    relay)       cmd_relay "$@" ;;
    probe)       cmd_probe "$@" ;;
    ""|-h|--help|help) usage ;;
    *)           usage >&2; exit 2 ;;
  esac
}

main "$@"
