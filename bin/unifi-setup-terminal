#!/usr/bin/env bash
# Terminal-side wrapper for the Omalaunch setup workflow. Omalaunch dispatches
# argument arrays with no stdin, but `setup` needs to read a key interactively —
# so the launcher opens a terminal on this instead of on the CLI directly. The
# pause keeps the result readable when the terminal would otherwise close.

set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

host=${1-}
if [[ -z $host ]]; then
  printf 'usage: unifi-setup-terminal <console-host>\n' >&2
  exit 2
fi

status=0
"$SELF_DIR/unifi-protect" setup "$host" || status=$?

printf '\n'
read -rsn1 -p 'Press any key to close…' || true
printf '\n'
exit "$status"
