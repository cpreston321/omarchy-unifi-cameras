#!/usr/bin/env bash
# Runs a unifi-protect subcommand in a terminal and waits before closing.
#
# The panel dispatches setup and key entry through a terminal because both
# prompt, and one of them reads a secret that must not pass through the panel.
# Without the pause the window closes the moment the command finishes, taking
# the success line — or the error — with it.

set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -eq 0 ]]; then
  printf 'usage: unifi-terminal <subcommand> [args...]\n' >&2
  exit 2
fi

status=0
"$SELF_DIR/unifi-protect" "$@" || status=$?

printf '\n'
read -rsn1 -p 'Press any key to close…' || true
printf '\n'
exit "$status"
