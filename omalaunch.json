{
  "schemaVersion": 1,
  "id": "quantumfire.unifi-cameras.setup",
  "capability": "unifi-cameras-setup",
  "mode": "workflow",
  "label": "UniFi Cameras Setup",
  "prefixes": [
    "unifi"
  ],
  "icon": "\udb81\udfae",
  "description": "Connect a UniFi Protect console",
  "rootDescription": "Connect and manage a UniFi Protect console",
  "requires": [
    "curl",
    "jq",
    "openssl",
    "secret-tool",
    "omarchy-launch-terminal"
  ],
  "workflow": {
    "items": [
      {
        "id": "connect",
        "kind": "input",
        "label": "Connect a console\u2026",
        "description": "Press Enter to scan, or type an address",
        "prompt": "Console address (Enter to scan)",
        "maxLength": 253,
        "command": [
          "omarchy-launch-terminal",
          "{extensionDir}/bin/unifi-setup-terminal",
          "{input}"
        ],
        "allowEmpty": true,
        "emptyCommand": [
          "omarchy-launch-terminal",
          "{extensionDir}/bin/unifi-setup-terminal"
        ]
      },
      {
        "id": "rekey",
        "kind": "input",
        "label": "Replace the API key\u2026",
        "description": "Opens a terminal to paste a new key",
        "prompt": "Press Enter to continue",
        "allowEmpty": true,
        "emptyCommand": [
          "omarchy-launch-terminal",
          "{extensionDir}/bin/unifi-protect",
          "key-set"
        ],
        "command": [
          "omarchy-launch-terminal",
          "{extensionDir}/bin/unifi-protect",
          "key-set"
        ]
      },
      {
        "id": "refresh",
        "kind": "input",
        "label": "Refresh camera list",
        "description": "Re-read cameras and snapshots from the console",
        "prompt": "Press Enter to refresh",
        "allowEmpty": true,
        "refreshExtensions": true,
        "emptyCommand": [
          "{extensionDir}/bin/unifi-protect",
          "refresh"
        ],
        "command": [
          "{extensionDir}/bin/unifi-protect",
          "refresh"
        ]
      },
      {
        "id": "check",
        "kind": "input",
        "label": "Test the connection",
        "description": "Verify the pin and stored key still work",
        "prompt": "Press Enter to test",
        "allowEmpty": true,
        "emptyCommand": [
          "omarchy-launch-terminal",
          "{extensionDir}/bin/unifi-protect",
          "check"
        ],
        "command": [
          "omarchy-launch-terminal",
          "{extensionDir}/bin/unifi-protect",
          "check"
        ]
      }
    ]
  }
}
