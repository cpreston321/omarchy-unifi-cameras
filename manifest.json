{
  "schemaVersion": 1,
  "id": "quantumfire.unifi-cameras",
  "name": "UniFi Cameras",
  "version": "0.1.0",
  "author": "Christian Preston",
  "license": "MIT",
  "description": "Local-first UniFi Protect camera panel: live view, snapshots, and camera settings. No cloud account, no camera daemon.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "UniFi Cameras",
    "description": "Snapshots and live view for UniFi Protect cameras",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "quality": "high",
      "refreshSeconds": 30,
      "panelQuality": "medium"
    },
    "schema": [
      {
        "key": "quality",
        "type": "string",
        "label": "Live stream quality (high, medium, low)"
      },
      {
        "key": "refreshSeconds",
        "type": "number",
        "label": "Snapshot refresh interval (seconds)"
      },
      {
        "key": "panelQuality",
        "type": "string",
        "label": "In-panel live stream quality (high, medium, low)"
      }
    ]
  }
}
